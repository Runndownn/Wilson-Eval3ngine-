# Wilson Eval3ngine environment template
#
# This file contains non-secret examples only. Do not copy real credentials,
# provider tokens, signing keys, or private topology into source control.

# Local development database and artifact paths. Production deployments must
# replace WE3_DATABASE_URL with an independently URL-encoded PostgreSQL URL.
WE3_DATABASE_URL=sqlite:///./var/we3.db
WE3_ARTIFACT_ROOT=./var/artifacts

# Authentication mode: dev or oidc. Production Compose fixes this to oidc.
WE3_AUTH_MODE=dev
WE3_ENVIRONMENT=development

# Provider egress policy.
# Local, loopback, and RFC1918/RFC4193 destinations are denied by default.
# Set to 1 only for an intentional trusted local/private model gateway while
# host/container egress policy blocks unrelated internal destinations.
WE3_GUI_ALLOW_LOCAL_PROVIDERS=0

# --- Production-only values ---
# Supply production values through the deployment platform's approved secret
# and configuration mechanism. docker-compose.prod.yml treats the required
# values as mandatory and does not use this file as a credential source.

# PostgreSQL bootstrap password. Set WE3_DATABASE_URL separately to a complete,
# independently encoded postgresql+psycopg URL for the API process.
WE3_POSTGRES_PASSWORD=

# Redis bootstrap credential and independently encoded client connection URL.
WE3_REDIS_PASSWORD=
WE3_REDIS_URL=

# Grafana administrator bootstrap credential.
WE3_GRAFANA_PASSWORD=

# OIDC settings.
WE3_OIDC_ISSUER=
WE3_OIDC_JWKS_URI=
WE3_OIDC_AUDIENCE=wilson-eval3ngine-api

# Public TLS routing.
WE3_DOMAIN=
WE3_TLS_EMAIL=

# Artifact encryption and browser-session controls.
WE3_ENCRYPTION_KEY=
WE3_CSRF_SECRET=
WE3_CORS_ALLOWED_ORIGINS=https://eval3ngine.invalid

# Rate limiting.
WE3_RATE_LIMIT_DEFAULT=1000
WE3_RATE_LIMIT_AUTH=10
WE3_RATE_LIMIT_BURST=20

# Actual request-body byte limit enforced by the ASGI receive wrapper.
WE3_MAX_BODY_SIZE=10485760

# Telemetry and logging.
WE3_TELEMETRY_ENABLED=true
WE3_TRACES_SAMPLE_RATE=1.0
WE3_LOGS_SAMPLE_RATE=0.1
WE3_LOG_LEVEL=INFO

# Wilson Eval3ngine Environment Configuration
# Copy this file to .env and customize for your deployment

# Database connection (default: SQLite for local development)
WE3_DATABASE_URL=sqlite:///./var/we3.db

# Artifact storage root (default: local var directory)
WE3_ARTIFACT_ROOT=./var/artifacts

# Authentication mode (dev, oidc, none)
WE3_AUTH_MODE=dev

# Environment (development, staging, production)
WE3_ENVIRONMENT=development

# Provider egress policy
# Default: local, loopback, and RFC1918/RFC4193 provider destinations are denied.
# Set to 1 only when this deployment intentionally uses a trusted local/private
# model gateway and network policy prevents access to unrelated internal assets.
WE3_GUI_ALLOW_LOCAL_PROVIDERS=0

# --- Production Settings ---

# OIDC settings (required for production OIDC mode)
WE3_OIDC_ISSUER=
WE3_OIDC_JWKS_URI=
WE3_OIDC_AUDIENCE=wilson-eval3ngine-api

# Redis for distributed rate limiting and token revocation (required for production)
WE3_REDIS_URL=

# Encryption key for Fernet-based artifact encryption (required for production)
WE3_ENCRYPTION_KEY=

# CSRF secret for double-submit token validation (required for production)
WE3_CSRF_SECRET=

# CORS allowed origins (comma-separated, required for production)
WE3_CORS_ALLOWED_ORIGINS=https://eval3ngine.local

# Rate limiting (requests per minute)
WE3_RATE_LIMIT_DEFAULT=1000
WE3_RATE_LIMIT_AUTH=10
WE3_RATE_LIMIT_BURST=20

# Request body size limit in bytes (default: 10MB)
WE3_MAX_BODY_SIZE=10485760

# Telemetry settings
WE3_TELEMETRY_ENABLED=true
WE3_TRACES_SAMPLE_RATE=1.0
WE3_LOGS_SAMPLE_RATE=0.1

# Logging
WE3_LOG_LEVEL=INFO

# TLS (for production behind reverse proxy)
WE3_TLS_EMAIL=

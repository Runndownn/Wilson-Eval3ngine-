# Wilson Eval3ngine environment template
#
# This file contains non-secret development examples and names of production
# configuration inputs. Never copy real credentials, URLs containing secrets,
# private network ranges, provider tokens, signing keys, or certificates into
# this file or source control.

# Local development database and artifact paths.
WE3_DATABASE_URL=sqlite:///./var/we3.db
WE3_ARTIFACT_ROOT=./var/artifacts
WE3_AUTH_MODE=dev
WE3_ENVIRONMENT=development

# Provider egress policy. Local, loopback, RFC1918, and RFC4193 destinations are
# denied by default. Enable only for an intentional trusted local/private model
# gateway while host/container egress policy blocks unrelated destinations.
WE3_GUI_ALLOW_LOCAL_PROVIDERS=0

# Browser-origin configuration is not a credential. In production use the exact
# approved HTTPS origin(s); an empty production value rejects browser Origin
# requests rather than allowing a wildcard.
WE3_CORS_ALLOWED_ORIGINS=https://eval3ngine.invalid

# Trusted forwarding ranges are deployment topology, not general client ranges.
# Leave empty in local development. Production should set this privately to only
# the Caddy->API network CIDR(s); Caddy overwrites X-Forwarded-For at ingress.
WE3_TRUSTED_PROXY_CIDRS=

# Request-admission and body bounds.
WE3_RATE_LIMIT_DEFAULT=1000
WE3_RATE_LIMIT_AUTH=10
WE3_RATE_LIMIT_BURST=20
WE3_MAX_BODY_SIZE=10485760

# Non-secret OIDC names. Production Compose requires real values through the
# approved deployment configuration mechanism.
WE3_OIDC_ISSUER=
WE3_OIDC_JWKS_URI=
WE3_OIDC_AUDIENCE=wilson-eval3ngine-api

# Public routing names (not credentials, but deployment-specific).
WE3_DOMAIN=
WE3_TLS_EMAIL=

# Telemetry/logging defaults.
WE3_TELEMETRY_ENABLED=true
WE3_TRACES_SAMPLE_RATE=1.0
WE3_LOGS_SAMPLE_RATE=0.1
WE3_LOG_LEVEL=INFO

# --- Production secret inputs ---
#
# docker-compose.prod.yml / docker-compose.secure.yml consume production secrets
# from private mounted files. These *_FILE variables name local/private files;
# the files themselves and their contents must not be committed.
WE3_POSTGRES_PASSWORD_FILE=
WE3_REDIS_PASSWORD_FILE=
WE3_GRAFANA_PASSWORD_FILE=
WE3_DATABASE_URL_FILE=
WE3_REDIS_URL_FILE=
WE3_ENCRYPTION_KEY_FILE=
WE3_CSRF_SECRET_FILE=
WE3_POSTGRES_TLS_CERT_FILE=
WE3_POSTGRES_TLS_KEY_FILE=
WE3_POSTGRES_TLS_CA_FILE=

# Production image references are supply-chain inputs and must be immutable
# registry/repository@sha256:<digest> values.
WE3_API_IMAGE=
WE3_POSTGRES_IMAGE=
WE3_REDIS_IMAGE=
WE3_CADDY_IMAGE=
WE3_PROMETHEUS_IMAGE=
WE3_GRAFANA_IMAGE=
WE3_EGRESS_PROXY_IMAGE=

# Private egress policy file; do not commit real destination policy.
WE3_EGRESS_POLICY_FILE=

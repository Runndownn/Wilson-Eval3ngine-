  "compatibility_policy": {
    "additive_optional_fields": "minor_version",
    "removed_fields": "major_version_required",
    "renamed_fields": "major_version_required",
    "score_affecting_changes": "major_version_required"
  },
  "canonical_serialization": {
    "encoding": "UTF-8",
    "key_ordering": "alphabetical",
    "numeric_representation": "canonical_decimal",
    "timestamp_format": "ISO_8601_with_offset",
    "identifier_format": "kebab-case"
  },
  "security_parsers": {
    "reject_duplicate_keys": true,
    "reject_invalid_unicode": true,
    "reject_non_finite_numbers": true,
    "reject_unsafe_yaml_tags": true,
    "reject_excessive_nesting": true,
    "reject_oversized_scalars": true,
    "max_nesting_depth": 128,
    "max_scalar_bytes": 1048576,
    "yaml_safe_constructors_only": true
  }

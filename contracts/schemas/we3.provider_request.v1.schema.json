{
  "$defs": {
    "ContentBlock": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "text",
          "default": "text",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "ContentBlock",
      "type": "object"
    },
    "ConversationTurn": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "items": {
            "$ref": "#/$defs/ContentBlock"
          },
          "minItems": 1,
          "title": "Content",
          "type": "array"
        },
        "role": {
          "enum": [
            "system",
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "ConversationTurn",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attempt Id",
      "type": "string"
    },
    "deadline": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deadline",
      "type": "string"
    },
    "experiment_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Experiment Id",
      "type": "string"
    },
    "expected_capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Expected Capabilities",
      "type": "array"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/ConversationTurn"
      },
      "title": "Messages",
      "type": "array"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "model_config_id": {
      "title": "Model Config Id",
      "type": "string"
    },
    "parameters": {
      "additionalProperties": true,
      "title": "Parameters",
      "type": "object"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "request_hash": {
      "default": "",
      "title": "Request Hash",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "we3.provider_request.v1",
      "default": "we3.provider_request.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "timeout_seconds": {
      "default": 60.0,
      "exclusiveMinimum": 0,
      "title": "Timeout Seconds",
      "type": "number"
    },
    "tool_definitions": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Tool Definitions",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "model_config_id",
    "provider",
    "model",
    "messages"
  ],
  "title": "ProviderRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wilson-eval3ngine.org/schemas/we3.provider_request.v1.schema.json"
}
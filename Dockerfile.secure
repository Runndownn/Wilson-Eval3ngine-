# Wilson Eval3ngine secure production image
#
# PYTHON_BASE_IMAGE has no default by design. The private build system must
# supply an immutable reference such as registry/repository@sha256:<64 hex>.

ARG PYTHON_BASE_IMAGE
FROM ${PYTHON_BASE_IMAGE} AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build
COPY pyproject.toml README.md LICENSE ./
COPY src ./src

RUN python -m pip install \
        "build==1.2.1" \
        "setuptools>=75,<76" \
        "wheel==0.47.0" \
    && python -m build --wheel --no-isolation \
    && python -m pip wheel \
        --wheel-dir /build/runtime-wheels \
        /build/dist/*.whl \
        "psycopg[binary]>=3.2,<4" \
        "boto3>=1.35,<2" \
        "redis>=5,<6"

FROM ${PYTHON_BASE_IMAGE} AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONHASHSEED=random \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HOME=/home/we3 \
    WE3_ENVIRONMENT=production \
    WE3_AUTH_MODE=oidc \
    WE3_ARTIFACT_ROOT=/var/lib/we3/artifacts \
    WE3_SECRET_BACKEND=mounted \
    WE3_SECRET_MOUNT=/run/secrets

RUN groupadd --system --gid 10001 we3 \
    && useradd --system --gid we3 --uid 10001 --home-dir /home/we3 \
        --create-home --shell /usr/sbin/nologin we3 \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && update-ca-certificates

COPY --from=builder /build/runtime-wheels /tmp/wheels
RUN python -m pip install --no-index --find-links=/tmp/wheels \
        /tmp/wheels/wilson_eval3ngine-*.whl \
    && rm -rf /tmp/wheels

WORKDIR /app
COPY --chown=we3:we3 contracts /app/contracts
COPY --chown=we3:we3 examples /app/examples

RUN install -d -o we3 -g we3 -m 0750 \
        /var/lib/we3/artifacts \
        /var/lib/we3/backups \
        /var/log/we3 \
        /app/var

USER 10001:10001
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD ["python", "-c", "import sys,urllib.request; r=urllib.request.urlopen('http://127.0.0.1:8000/ready', timeout=5); sys.exit(0 if r.status == 200 else 1)"]

CMD ["python", "-m", "uvicorn", "wilson_eval3ngine.api.secure_entrypoint:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4", "--no-server-header", "--timeout-keep-alive", "10", "--limit-max-requests", "10000"]

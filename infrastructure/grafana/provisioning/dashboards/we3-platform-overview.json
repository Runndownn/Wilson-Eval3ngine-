      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mapping": {
            "options": {
              "0": {
                "index": 0,
                "text": "Down"
              },
              "1": {
                "index": 1,
                "text": "Up"
              }
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
